{
  "name": "stc-website-new",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "echo 'Pick a site: npm run dev:noum  or  npm run dev:orem' && exit 1",
    "dev:noum": "SANITY_ACTIVE_ENV=noum sanity dev --port 3334",
    "dev:orem": "SANITY_ACTIVE_ENV=orem sanity dev --port 3334",
    "start": "sanity start --port 3334",
    "build": "sanity build",
    "build:noum": "SANITY_ACTIVE_ENV=noum sanity build",
    "build:orem": "SANITY_ACTIVE_ENV=orem sanity build",
    "deploy": "echo 'Pick a site: npm run deploy:noum  or  npm run deploy:orem' && exit 1",
    "deploy:noum": "SANITY_ACTIVE_ENV=noum sanity deploy",
    "deploy:orem": "SANITY_ACTIVE_ENV=orem sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "update-cors": "echo 'Pick a site: npm run update-cors:noum  or  npm run update-cors:orem' && exit 1",
    "update-cors:noum": "SANITY_ACTIVE_ENV=noum npx ts-node ./update-cors.ts",
    "update-cors:orem": "SANITY_ACTIVE_ENV=orem npx ts-node ./update-cors.ts",
    "site": "node scripts/site.mjs"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/client": "^7.12.0",
    "@sanity/vision": "^4.5.0",
    "axios": "^1.13.1",
    "dotenv": "^17.3.1",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "^5.17.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}

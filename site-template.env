# Studio settings for one website. Copy to .env.<site> (e.g. .env.acme) and fill in.
# .env.* files are never committed (they hold the token). Start with: npm run site -- dev <site>
SANITY_STUDIO_TITLE=""            # shown in the Studio, e.g. "ACME"
SANITY_STUDIO_PROJECT_ID=""       # the client's own Sanity project ID
SANITY_STUDIO_DATASET="production"
SANITY_STUDIO_HOST=""             # online Studio address: <host>.sanity.studio
SANITY_AUTH_TOKEN=""              # only needed for "npm run site -- cors"; create in sanity.io/manage
VITE_SITE_TITLE=""                # same as in the website settings
VITE_SITE_URL=""                  # live address, e.g. "https://www.acme.com"
SANITY_DEV_PORT="3334"            # local Studio port; run one Studio at a time on 3334, or pick another
